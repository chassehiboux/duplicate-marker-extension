{
  "manifest_version": 3,
  "name": "Помощник по Пирамиде",
  "version": "2.0.75",
  "description": "Авто-режим + Проверка ИНН/Смерти + Мониторинг скорости стадий",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "sidePanel",
    "webRequest",
    "declarativeNetRequest",
    "notifications",
    "tabs",
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pyramid_redirects",
        "enabled": true,
        "path": "redirector/redirect_rules.json"
      }
    ]
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Открыть панель",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://pyramid.vostok-electra.ru/*",
        "*://*.pyramid.vostok-electra.ru/*",
        "*://pyramid.nesko-nv.ru/*",
        "*://*.pyramid.nesko-nv.ru/*",
        "*://pyramid-vostok.electra.ru/*",
        "*://*.pyramid-vostok.electra.ru/*"
      ],
      "js": [
        "extension_ui_config.js",
        "IdCardServiceInfo/status_names.js",
        "IdCardServiceInfo/service_info.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension_ui_config.js",
        "content.js",
        "ColumnManager/column_manager.js",
        "FsspRegistrySearch/fssp_registry_search.js",
        "OvzidTransferRegistrySearch/ovzid_transfer_registry_search.js",
        "CallCenterRegistrySearch/call_center_registry_search.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/d/1A7bsMpcMegLvTIpdRBa06TD5RxGi64Cw3goYydbujNo/*"
      ],
      "js": [
        "GoogleSheets/problem_picker_config.js",
        "GoogleSheets/itil_category_model.js",
        "GoogleSheets/itil_category_predictor.js",
        "GoogleSheets/problem_picker_content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "ChatGPT/chat_manager.css"
      ],
      "js": [
        "ChatGPT/chat_manager.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "StageTimer/screenshot_hotkeys_bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "Check_INN_DeathDate/inn_death_content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "*://pyramid.vostok-electra.ru/*",
        "*://*.pyramid.vostok-electra.ru/*",
        "*://pyramid.nesko-nv.ru/*",
        "*://*.pyramid.nesko-nv.ru/*",
        "*://pyramid-vostok.electra.ru/*",
        "*://*.pyramid-vostok.electra.ru/*"
      ],
      "js": [
        "VZIDCapture/vzid_create_send.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://pyramid.vostok-electra.ru/*",
        "*://*.pyramid.vostok-electra.ru/*",
        "*://pyramid.nesko-nv.ru/*",
        "*://*.pyramid.nesko-nv.ru/*",
        "*://pyramid-vostok.electra.ru/*",
        "*://*.pyramid-vostok.electra.ru/*"
      ],
      "css": [
        "StageTimer/timer_styles.css"
      ],
      "js": [
        "extension_ui_config.js",
        "id_card_check_nav_bootstrap.js",
        "StageTimer/timer_content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://pyramid.vostok-electra.ru/*",
        "*://*.pyramid.vostok-electra.ru/*",
        "*://pyramid.nesko-nv.ru/*",
        "*://*.pyramid.nesko-nv.ru/*",
        "*://pyramid-vostok.electra.ru/*",
        "*://*.pyramid-vostok.electra.ru/*"
      ],
      "js": [
        "StageTimer/incident_frame_content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://pyramid.vostok-electra.ru/*",
        "*://*.pyramid.vostok-electra.ru/*",
        "*://pyramid.nesko-nv.ru/*",
        "*://*.pyramid.nesko-nv.ru/*"
      ],
      "css": [
        "PyramidNewYear/pyramid_theme_settings.css",
        "PyramidNewYear/pyramid_christmas.css",
        "PyramidNewYear/pyramid_spring.css"
      ],
      "js": [
        "PyramidNewYear/pyramid_theme_config.js",
        "PyramidNewYear/pyramid_theme_settings.js",
        "PyramidNewYear/pyramid_christmas.js",
        "PyramidNewYear/pyramid_spring.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://support.vostok-electra.ru/*"
      ],
      "js": [
        "support/support_content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "reestr_dz_pdf_viewer.html"
      ],
      "matches": [
        "*://wssdocs.vostok-electra.ru/*"
      ]
    }
  ]
}
